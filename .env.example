# PostgreSQL (on-premises). Prefer DATABASE_URL; individual values are supported too.
DATABASE_URL=postgresql://rpa_app:change-me@db-host:5432/rpa_db
PGHOST=
PGPORT=5432
PGDATABASE=rpa_db
PGUSER=
PGPASSWORD=
PGSSLMODE=prefer

# Local development only. Azure App Service uses its authenticated identity header.
DEV_USER_EMAIL=demo@company.com

# Set true only for a temporary UI preview without a reachable database.
USE_DEMO_DATA=true

# Optional Power Automate HTTP trigger defaults (per-RPA URL in DB takes precedence).
POWER_AUTOMATE_WEBHOOK_URL=
POWER_AUTOMATE_SHARED_SECRET=
